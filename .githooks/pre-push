#!/bin/sh
set -e

case "$(uname -s 2>/dev/null || echo unknown)" in
    MINGW*|MSYS*|CYGWIN*)
        cmd.exe //c check.bat
        ;;
    *)
        export SDL_VIDEODRIVER=dummy
        export SDL_AUDIODRIVER=dummy
        export PYTHONUTF8=1

        if command -v python3 >/dev/null 2>&1; then
            PYTHON_BIN=python3
        else
            PYTHON_BIN=python
        fi

        echo "[1/2] ruff check"
        "$PYTHON_BIN" -m ruff check --select F,E9 sap_visualizer main.py packaging tests

        echo "[2/2] pytest"
        "$PYTHON_BIN" -m pytest -q
        ;;
esac
